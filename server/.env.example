DATABASE_URL=postgresql://user:password@localhost:5432/gestionar
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
# Only for a local PostgreSQL instance without TLS:
# PGSSL=disable
# PGSSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Business civil date (default: Argentina)
BUSINESS_TIME_ZONE=America/Argentina/Buenos_Aires
# Comma-separated trusted ingress networks. Leave empty for direct connections.
TRUST_PROXY_CIDRS=
# Render is detected via RENDER=true; other deployments must configure trusted proxies.
