{
  "name": "instituteapp-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/regression.cjs",
    "test:preview": "npm run build && node tests/preview-smoke.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "axios": "^1.21.0",
    "dompurify": "^3.4.17",
    "jspdf": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.3.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.6.0"
}
